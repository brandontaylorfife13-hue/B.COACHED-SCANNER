rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCoach() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "coach";
    }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    match /invitations/{email} {
      allow create, delete: if isCoach();
      allow update: if isCoach()
        || (signedIn()
            && request.auth.token.email_verified == true
            && request.auth.token.email == resource.data.email
            && resource.data.status == "pending"
            && request.resource.data.status == "accepted"
            && request.resource.data.acceptedBy == request.auth.uid
            && request.resource.data.acceptedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "acceptedBy", "acceptedAt"]));
      allow read: if isCoach()
        || (signedIn() && request.auth.token.email_verified == true
            && request.auth.token.email == resource.data.email);
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.auth.token.email_verified == true
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "client"
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
        && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.status == "pending"
        && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.email == request.auth.token.email;
      allow read: if isOwner(userId) || isCoach();
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      match /notifications/{notificationId} {
        allow create: if signedIn()
          && request.auth.uid != userId
          && get(/databases/$(database)/documents/users/$(userId)).data.role == "coach"
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "client"
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coachUid == userId
          && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
          && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.status == "accepted"
          && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.acceptedBy == request.auth.uid
          && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.createdBy == userId
          && request.resource.data.clientUid == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /{subcollection}/{documentId} {
        allow read: if isOwner(userId) || isCoach();
        allow create, update, delete: if isOwner(userId) || isCoach();
      }

      // Allow the same owner/coach access to deeper nested records,
      // such as foodLogs/{date}/entries/{entryId}.
      match /{nestedPath=**} {
        allow read: if isOwner(userId) || isCoach();
        allow create, update, delete: if isOwner(userId) || isCoach();
      }
    }
  }
}